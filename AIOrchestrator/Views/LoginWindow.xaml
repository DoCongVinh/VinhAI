<Window x:Class="AIOrchestrator.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AIOrchestrator.Models"
        mc:Ignorable="d"
        Title="Vinh-AI — Đăng nhập"
        Height="760"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="#0F172A"/>
            <Setter Property="Foreground"
                    Value="#F8FAFC"/>
            <Setter Property="BorderBrush"
                    Value="#334155"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background"
                    Value="#0F172A"/>
            <Setter Property="Foreground"
                    Value="#F8FAFC"/>
            <Setter Property="BorderBrush"
                    Value="#334155"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background"
                    Value="#1E293B"/>
            <Setter Property="Foreground"
                    Value="#94A3B8"/>
            <Setter Property="Padding"
                    Value="14,8"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡"
                        FontSize="34"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VINH-AI"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#38BDF8"/>
                    <TextBlock Text="Đăng nhập để sử dụng ứng dụng"
                            FontSize="12"
                            Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- TABS -->
        <TabControl Grid.Row="1"
                Background="Transparent"
                BorderThickness="0">

            <!-- LOGIN TAB -->
            <TabItem Header="🔐 Đăng nhập">
                <Border Background="#1E293B"
                        CornerRadius="8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="20"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Tên đăng nhập, email hoặc số điện thoại"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLoginUsername"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock Text="Mật khẩu"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,14,0,4"/>
                        <PasswordBox x:Name="PwdLoginPassword"
                                Height="36"
                                VerticalContentAlignment="Center"
                                     KeyDown="Login_KeyDown"/>

                        <CheckBox x:Name="ChkRememberPassword"
                                Content="Lưu mật khẩu trên máy này"
                                Foreground="#CBD5E1"
                                Margin="0,10,0,0"/>

                        <TextBlock x:Name="TxtLoginError"
                                Foreground="#F87171"
                                FontSize="12"
                                TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                Visibility="Collapsed"/>

                        <Button x:Name="BtnLogin"
                                Content="Đăng nhập"
                                Height="40"
                                Margin="0,18,0,0"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnLogin_Click"/>

                    </StackPanel>
                </Border>
            </TabItem>

            <!-- REGISTER TAB -->
            <TabItem Header="📝 Đăng ký">
                <Border Background="#1E293B"
                        CornerRadius="8"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="20"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Tên đăng nhập (ít nhất 3 ký tự)"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRegUsername"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock Text="Tên hiển thị"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,12,0,4"/>
                        <TextBox x:Name="TxtRegDisplayName"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock Text="Email"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,12,0,4"/>
                        <TextBox x:Name="TxtRegEmail"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock Text="Số điện thoại (10–15 chữ số)"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,12,0,4"/>
                        <TextBox x:Name="TxtRegPhone"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock Text="Mật khẩu (ít nhất 6 ký tự)"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,12,0,4"/>
                        <PasswordBox x:Name="PwdRegPassword"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock Text="Nhập lại mật khẩu"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Margin="0,12,0,4"/>
                        <PasswordBox x:Name="PwdRegConfirm"
                                Height="36"
                                VerticalContentAlignment="Center"/>

                        <TextBlock x:Name="TxtRegMessage"
                                FontSize="12"
                                TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                Visibility="Collapsed"/>

                        <Button x:Name="BtnRegister"
                                Content="Gửi đăng ký"
                                Height="40"
                                Margin="0,18,0,0"
                                Background="#0EA5E9"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnRegister_Click"/>

                        <TextBlock Text="Sau khi đăng ký, tài khoản của bạn cần được quản trị viên phê duyệt trước khi đăng nhập được."
                                   FontSize="11"
                                Foreground="#64748B"
                                Margin="0,12,0,0"
                                TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>

        <!-- FOOTER -->
        <TextBlock Grid.Row="2"
                Text="© 2026 Vinh-AI • Hệ thống điều phối đa AI"
                FontSize="11"
                   Foreground="#475569"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"/>
    </Grid>
</Window>