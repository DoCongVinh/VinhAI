<Window x:Class="AIOrchestrator.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AIOrchestrator.Models"
        mc:Ignorable="d"
        Title="Vinh-AI — Quản trị tài khoản"
        Height="700"
        Width="940"
        MinHeight="560"
        MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                Margin="0,0,0,12">
            <TextBlock Text="🛡️ QUẢN TRỊ TÀI KHOẢN"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#38BDF8"/>
            <TextBlock Text="Duyệt hoặc từ chối các tài khoản đăng ký mới. Tài khoản admin không thể bị xóa."
                       FontSize="12"
                    Foreground="#94A3B8"
                    Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="AdminTabs">
            <TabItem Header="👥 Tài khoản">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <ItemsControl x:Name="ItemsUsers">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:UserAccount}">
                                <Border Background="#1E293B" CornerRadius="6" BorderBrush="#334155"
                                        BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✅ Duyệt" Padding="10,5" Margin="0,0,6,0"
                                                    Background="#16A34A" Foreground="White" BorderThickness="0"
                                                    FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                                                    Click="BtnApprove_Click" Tag="{Binding}"/>
                                            <Button Content="⛔ Từ chối" Padding="10,5" Margin="0,0,6,0"
                                                    Background="#D97706" Foreground="White" BorderThickness="0"
                                                    FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                                                    Click="BtnReject_Click" Tag="{Binding}"/>
                                            <Button Content="🗑️ Xóa" Padding="10,5" Background="#DC2626"
                                                    Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                                                    FontSize="12" Cursor="Hand" Click="BtnDeleteUser_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                                                <Border Background="#334155" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Role}" FontSize="10" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                <Run Text="Tên đăng nhập: "/><Run Text="{Binding Username}"/>
                                                <Run Text="  •  "/><Run Text="{Binding StatusDisplayName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                                                <Run Text="Email: "/><Run Text="{Binding Email}"/>
                                                <Run Text="  •  SĐT: "/><Run Text="{Binding PhoneNumber}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabAdminMessages" Header="💬 Tin nhắn">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Cấp mã chat cho người dùng:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtAccessCodeDisplayName" Width="180" Margin="0,0,8,0"
                                 ToolTip="Tên người dùng hiển thị trong hộp thư"/>
                        <Button Content="Tạo mã truy cập" Padding="10,5" Background="#2563EB"
                                Foreground="White" BorderThickness="0" Click="BtnCreateAccessCode_Click"/>
                        <TextBlock x:Name="TxtUnreadNotice" DockPanel.Dock="Right" Foreground="#FBBF24"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ListChatThreads" SelectionChanged="ListChatThreads_SelectionChanged"
                                 Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3">
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding UnreadCount, StringFormat='● {0}'}" Foreground="#FBBF24"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"
                                                   FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:dd/MM HH:mm}'}"
                                                   FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="5" Padding="7">
                                <ScrollViewer x:Name="ScrollAdminChat" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsAdminChat">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E293B" CornerRadius="5" Padding="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="#38BDF8" Margin="0,0,0,3"/>
                                                        <TextBox Text="{Binding Content}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180"
                                                                 Background="Transparent" Foreground="#F8FAFC"
                                                                 BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAdminReply" Height="38" VerticalContentAlignment="Center"
                                         TextWrapping="Wrap" Padding="8" IsEnabled="False"/>
                                <Button x:Name="BtnAdminReply" Grid.Column="1" Content="Trả lời" Padding="12,5"
                                        Margin="8,0,0,0" Background="#2563EB" Foreground="White"
                                        BorderThickness="0" IsEnabled="False" Click="BtnAdminReply_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>