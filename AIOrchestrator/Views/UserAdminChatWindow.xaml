<Window x:Class="AIOrchestrator.Views.UserAdminChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liên hệ quản trị viên"
        Width="620"
        Height="620"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💬 Liên hệ với quản trị viên" FontSize="18" FontWeight="Bold"
                   Foreground="#38BDF8" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="TxtAccessCode" VerticalContentAlignment="Center" Padding="8"
                         ToolTip="Nhập mã chat do quản trị viên cấp"/>
            <Button x:Name="BtnConnect" Grid.Column="1" Content="Kết nối" Padding="12,6" Margin="8,0,0,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    Click="BtnConnect_Click"/>
            <TextBlock x:Name="TxtChatStatus" Grid.Column="2" VerticalAlignment="Center"
                       Margin="10,0,0,0" Foreground="#94A3B8"/>
        </Grid>
        <Border Grid.Row="2" Background="#111827" BorderBrush="#334155" BorderThickness="1"
                CornerRadius="6" Padding="8">
            <ScrollViewer x:Name="ScrollMessages" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsMessages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="6" Padding="9" Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="{Binding SenderName}" FontSize="11" FontWeight="Bold"
                                               Foreground="#38BDF8" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Content}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180"
                                             Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                                             Padding="0" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtMessage" Height="42" VerticalContentAlignment="Center"
                     TextWrapping="Wrap" Padding="8" KeyDown="TxtMessage_KeyDown"
                     IsEnabled="False" ToolTip="Nhập tin nhắn (Enter để gửi)"/>
            <Button x:Name="BtnSend" Grid.Column="1" Content="Gửi ↵" Padding="16,6" Margin="8,0,0,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    IsEnabled="False" Click="BtnSend_Click"/>
        </Grid>
    </Grid>
</Window>
