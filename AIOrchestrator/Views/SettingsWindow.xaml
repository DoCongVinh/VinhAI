<Window x:Class="AIOrchestrator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cài đặt API Keys" Height="700" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F4F4F5"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ Cấu hình API Keys Cloud" FontSize="20" FontWeight="SemiBold" Foreground="#38BDF8"/>
            <TextBlock Text="Ứng dụng sử dụng API để không ngốn dung lượng máy. Bạn có thể dùng gói miễn phí của Google và Groq hoàn toàn 0đ."
                       FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Form content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- Gemini -->
                <Border Background="#202024" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#2DD4BF" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="🌟 Google Gemini API (trò chuyện và đọc tệp)" FontWeight="Bold" FontSize="14" Foreground="#2DD4BF"/>
                            <TextBlock Text="Lấy key miễn phí" HorizontalAlignment="Right" Cursor="Hand" Foreground="#38BDF8" TextDecorations="Underline" MouseDown="OpenGeminiLink_MouseDown"/>
                        </DockPanel>
                        <TextBlock Text="Key Google AI Studio dùng cho trò chuyện và phân tích ảnh/PDF đính kèm. Tạo đồ thị và thiết kế dùng Pollinations AI, không cần Gemini key."
                                   FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,8"/>
                        <PasswordBox x:Name="TxtGeminiKey"/>
                    </StackPanel>
                </Border>

                <!-- Groq -->
                <Border Background="#202024" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#F97316" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="⚡ Groq Cloud API (Siêu tốc - Free)" FontWeight="Bold" FontSize="14" Foreground="#F97316"/>
                            <TextBlock Text="Lấy key miễn phí" HorizontalAlignment="Right" Cursor="Hand" Foreground="#38BDF8" TextDecorations="Underline" MouseDown="OpenGroqLink_MouseDown"/>
                        </DockPanel>
                        <TextBlock Text="Tốc độ ~300 tokens/s, chạy Llama 3.3 70B Versatile, Llama 3.1 8B..." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,8"/>
                        <PasswordBox x:Name="TxtGroqKey"/>
                    </StackPanel>
                </Border>

                <!-- OpenAI / DeepSeek / Custom -->
                <Border Background="#202024" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#3F3F46" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🌐 Custom Endpoint / OpenAI / DeepSeek (Tùy chọn)" FontWeight="Bold" FontSize="14" Foreground="#E4E4E7"/>
                        <TextBlock Text="Tương thích bất kỳ dịch vụ nào hỗ trợ OpenAI API format (DeepSeek, Together, Ollama...)" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,8"/>
                        
                        <TextBlock Text="API Key:" FontSize="12" Foreground="#D4D4D8" Margin="0,2,0,2"/>
                        <PasswordBox x:Name="TxtOpenAiKey" Margin="0,0,0,8"/>

                        <TextBlock Text="Base URL:" FontSize="12" Foreground="#D4D4D8" Margin="0,2,0,2"/>
                        <TextBox x:Name="TxtOpenAiBaseUrl" Text="https://api.openai.com/v1"/>
                    </StackPanel>
                </Border>

                <Border Background="#202024" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#38BDF8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💬 Chat User ↔ Admin (Backend)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                        <TextBlock Text="Cấu hình URL HTTPS của chat server. Khóa quản trị chỉ nhập trên máy admin; người dùng cần mã truy cập do admin cấp."
                                   FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="Chat server URL:" FontSize="12" Foreground="#D4D4D8" Margin="0,2,0,2"/>
                        <TextBox x:Name="TxtChatServerUrl" Margin="0,0,0,8"/>
                        <TextBlock Text="Admin API key (chỉ máy admin):" FontSize="12" Foreground="#D4D4D8" Margin="0,2,0,2"/>
                        <PasswordBox x:Name="TxtChatAdminApiKey"/>
                    </StackPanel>
                </Border>

                <Border Background="#202024" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#A78BFA" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔄 Cập nhật ứng dụng" FontWeight="Bold" FontSize="14" Foreground="#A78BFA"/>
                        <TextBlock Text="Vinh-AI mặc định kiểm tra bản mới qua GitHub và chỉ tải/cài sau khi bạn đồng ý. Để trống URL nếu muốn tắt kiểm tra."
                                   FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="URL manifest HTTPS:" FontSize="12" Foreground="#D4D4D8" Margin="0,2,0,2"/>
                        <TextBox x:Name="TxtUpdateManifestUrl"/>
                        <TextBlock Text="Manifest cần có version, downloadUrl, sha256 và tùy chọn releaseNotes. Tệp tải về phải là VinhAI.exe."
                                   FontSize="11" Foreground="#71717A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy bỏ" Width="100" Height="36" Margin="0,0,10,0" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="💾 Lưu Cài Đặt" Width="130" Height="36" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
