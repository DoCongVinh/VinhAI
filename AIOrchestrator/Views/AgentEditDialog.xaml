<Window x:Class="AIOrchestrator.Views.AgentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cấu hình AI Chuyên dụng" Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#18181B" Foreground="#F4F4F5"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtHeaderTitle" Text="🤖 Thêm / Chỉnh sửa AI Chuyên dụng" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8"/>
            <TextBlock Text="Định nghĩa vai trò và nhiệm vụ chuyên trách để AI chỉ chạy khi có việc tương ứng." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <!-- Icon + Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Icon:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtIcon" Text="🤖" FontSize="16" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tên hiển thị của AI:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName" Text="AI Chuyên gia..."/>
                    </StackPanel>
                </Grid>

                <!-- Role -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Vai trò / Chuyên môn chính:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRole" Text="Mô tả ngắn gọn về nhiệm vụ chuyên biệt của con AI này..."/>
                </StackPanel>

                <!-- Provider & Model -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Nhà cung cấp (Provider):" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbProvider" SelectionChanged="CmbProvider_SelectionChanged">
                            <ComboBoxItem Content="Google Gemini (Free)" Tag="Gemini" IsSelected="True"/>
                            <ComboBoxItem Content="Groq Cloud (Free Superfast)" Tag="Groq"/>
                            <ComboBoxItem Content="OpenAI / DeepSeek / Custom" Tag="OpenAICompatible"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Tên Model:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtModelName" Text="gemini-3.8-flash"/>
                    </StackPanel>
                </Grid>

                <!-- Temperature -->
                <StackPanel Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Độ sáng tạo (Temperature):" FontSize="12" Foreground="#A1A1AA"/>
                        <TextBlock x:Name="TxtTempValue" Text="0.7" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                    </DockPanel>
                    <Slider x:Name="SliderTemp" Minimum="0" Maximum="1" Value="0.7" SmallChange="0.1" LargeChange="0.2" TickFrequency="0.1" Margin="0,6,0,0" ValueChanged="SliderTemp_ValueChanged"/>
                </StackPanel>

                <!-- System Prompt -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Chỉ dẫn hệ thống (System Prompt - Nhiệm vụ chuyên dụng):" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSystemPrompt" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Width="90" Height="34" Margin="0,0,10,0" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="Xác nhận" Width="100" Height="34" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
