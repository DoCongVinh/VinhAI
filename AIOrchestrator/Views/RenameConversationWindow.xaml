<Window x:Class="AIOrchestrator.Views.RenameConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi tên cuộc trò chuyện"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tên cuộc trò chuyện"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="TxtTitle"
                 Grid.Row="1"
                 Padding="8"
                 Background="#1E293B"
                 Foreground="#F8FAFC"
                 BorderBrush="#475569"
                 KeyDown="TxtTitle_KeyDown"/>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Hủy"
                    MinWidth="80"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Lưu"
                    MinWidth="80"
                    Padding="10,6"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
